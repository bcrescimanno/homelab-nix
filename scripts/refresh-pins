#!/usr/bin/env bash
# scripts/refresh-pins — update the two pins no bot could see
#
# Everything else in this repo updates itself: flake inputs through Renovate's
# lockFileMaintenance, container images through the custom.regex manager. These
# two were matched by neither.
#
#   materialious       a fetchFromGitHub tag. Genuinely invisible — it sat at
#                      1.17.6 for four weeks across five upstream releases and
#                      the only thing that ever moved it was somebody noticing.
#
#   caddy-cloudflare   an FOD hash over the resolved Go module graph. It goes
#                      stale on a nixpkgs Go toolchain bump, not on a Caddy
#                      release. This one is NOT silently invisible any more:
#                      since #609 the native build is a required check, so a
#                      lock update that invalidates the hash fails CI and cannot
#                      merge. What it does instead is BLOCK that PR. Running
#                      this script on the blocked branch is the one-command fix,
#                      in place of transcribing "got:" out of a CI log.
#
# Usage:
#   scripts/refresh-pins             update both in place
#   scripts/refresh-pins --check     report drift, change nothing, exit 1 if stale
#   scripts/refresh-pins caddy       just one of them (caddy | materialious)
#
# Both are flake outputs (.#materialious, .#caddy-cloudflare) purely so tooling
# can reach them; the NixOS modules callPackage the same files, so there is one
# definition each and the two cannot drift.

set -euo pipefail

REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$REPO"

CHECK=false
TARGET="all"
for arg in "$@"; do
  case "$arg" in
    --check)              CHECK=true ;;
    caddy|materialious)   TARGET="$arg" ;;
    -h|--help)            sed -n '2,30p' "$0" | sed 's/^# \?//'; exit 0 ;;
    *) echo "unknown argument: $arg" >&2; exit 1 ;;
  esac
done

RED=$'\033[0;31m'; GREEN=$'\033[0;32m'; YELLOW=$'\033[1;33m'; CYAN=$'\033[0;36m'; NC=$'\033[0m'
step() { echo "${CYAN}▶ $1${NC}"; }
ok()   { echo "  ${GREEN}✓${NC} $1"; }
warn() { echo "  ${YELLOW}⚠${NC} $1"; }
die()  { echo "${RED}✗ $1${NC}" >&2; exit 1; }

DRIFT=0

# ─── materialious ────────────────────────────────────────────────────────────
#
# nix-update resolves the flake attribute, reads the latest tag off
# releases.atom, and rewrites version, src.hash and npmDepsHash itself. Being
# unable to compute those two hashes was the stated reason this pin was left
# manual — Renovate cannot, nix-update can, which is the whole trick.
refresh_materialious() {
  step "materialious"
  local before after
  before="$(nix eval --raw .#materialious.version 2>/dev/null || echo unknown)"

  if $CHECK; then
    # --version-regex keeps it on plain numeric tags; upstream also publishes
    # capacitor-* and desktop-* tags that are not this package.
    nix run nixpkgs#nix-update -- --flake materialious \
      --version-regex '^([0-9.]+)$' 2>&1 | grep -qi "already" && {
        ok "materialious $before is current"; return 0; }
    warn "materialious $before is behind upstream"
    git checkout -- pkgs/materialious.nix 2>/dev/null || true
    DRIFT=1
    return 0
  fi

  nix run nixpkgs#nix-update -- --flake materialious --version-regex '^([0-9.]+)$'
  after="$(nix eval --raw .#materialious.version 2>/dev/null || echo unknown)"
  if [[ "$before" == "$after" ]]; then
    ok "materialious $before is current"
  else
    ok "materialious $before -> $after"
    warn "RE-READ pkgs/materialious.nix before merging: a workaround that is no"
    warn "longer NEEDED keeps applying silently. --replace-fail only catches the"
    warn "opposite case. installCheckPhase asserts both shaka patches landed."
    DRIFT=1
  fi
}

# ─── caddy-cloudflare ────────────────────────────────────────────────────────
#
# `hash` is an argument to pkgs/caddy-cloudflare.nix, so it can be overridden
# with lib.fakeHash and the correct value read out of the resulting mismatch —
# no editing the file mid-build and no restore-on-failure dance.
#
# Runs on whatever arch is to hand: the FOD is vendored Go SOURCE, not compiled
# output, so its hash is architecture-independent and an x86_64 result is valid
# for the aarch64 hosts that actually run Caddy.
refresh_caddy() {
  step "caddy-cloudflare"
  local current got
  current="$(grep -oE 'hash \? "sha256-[^"]+"' pkgs/caddy-cloudflare.nix | grep -oE 'sha256-[^"]+')"
  [[ -n "$current" ]] || die "could not read the current hash out of pkgs/caddy-cloudflare.nix"

  got="$(nix build --no-link --impure --expr "
    let
      f = builtins.getFlake \"path:$REPO\";
      pkgs = f.inputs.nixpkgs.legacyPackages.\${builtins.currentSystem};
    in pkgs.callPackage $REPO/pkgs/caddy-cloudflare.nix { hash = pkgs.lib.fakeHash; }
  " 2>&1 | grep -oP '^\s*got:\s+\K\S+' || true)"

  [[ -n "$got" ]] || die "no 'got:' line in the build output — the FOD may have built clean, meaning fakeHash did not take. Investigate before trusting this script again."

  if [[ "$got" == "$current" ]]; then
    ok "caddy plugin hash is current ($current)"
    return 0
  fi

  DRIFT=1
  if $CHECK; then
    warn "caddy plugin hash is stale"
    warn "  have: $current"
    warn "  want: $got"
    return 0
  fi

  sed -i "s#hash ? \"$current\"#hash ? \"$got\"#" pkgs/caddy-cloudflare.nix
  grep -q "$got" pkgs/caddy-cloudflare.nix || die "sed did not apply the new hash"
  ok "caddy plugin hash $current -> $got"
}

[[ "$TARGET" == "all" || "$TARGET" == "materialious" ]] && refresh_materialious
[[ "$TARGET" == "all" || "$TARGET" == "caddy" ]]        && refresh_caddy

echo
if [[ $DRIFT -eq 0 ]]; then
  echo "${GREEN}Both pins are current.${NC}"
  exit 0
fi
$CHECK && { echo "${YELLOW}Drift detected (--check made no changes).${NC}"; exit 1; }
echo "${YELLOW}Pins updated. Review the diff, then commit and open a PR.${NC}"
exit 0
