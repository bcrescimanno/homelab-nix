#!/usr/bin/env bash
# scripts/check-overlays — ask whether each temporary overlay can be dropped yet
#
# Every overlay in flake.nix works around an upstream bug and every comment ends
# with some form of "remove once nixpkgs fixes it". Nothing checked, so they
# accrued. The dangerous direction is silent: an overlay that is no longer
# NEEDED keeps applying forever, disabling tests that would now pass and hiding
# a real regression the day one appears.
#
# The question is answerable mechanically — build the package UNPATCHED against
# the current lock. If it builds clean, the workaround is dead weight.
#
# WHAT THIS REPLACES, AND WHY IT IS NOT JUST A MOVE
#
# modules/nixpkgs-watch.nix did a version-comparison version of this on a timer.
# It had never worked. It fetched
#   https://channels.nixos.org/nixos-unstable/git-revision
# with `curl -sf` and no -L. That URL answers 302, curl without -L emits an
# empty body and exits 0, and the script's own `[ -z "$REV" ] && exit 0` guard
# then swallowed it. The unit reported success, the timer stayed active, the
# state dir stayed empty, and it silently checked nothing from the day it landed
# (verified on rivendell 2026-08-26 by running the real unit).
#
# So this deliberately does NOT ask a remote for a version string. It builds the
# thing. A build either succeeds or it does not, and there is no code path where
# "I could not find out" is indistinguishable from "nothing to report".
#
# Usage:
#   scripts/check-overlays                  probe everything meaningful here
#   scripts/check-overlays --ntfy URL       also send a digest
#   scripts/check-overlays --timeout 900    per-probe seconds (default 2700)
#   scripts/check-overlays glances          just one

set -uo pipefail

REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$REPO"

NTFY=""
TIMEOUT=2700
ONLY=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --ntfy)    NTFY="${2:?--ntfy needs a URL}"; shift 2 ;;
    --timeout) TIMEOUT="${2:?--timeout needs seconds}"; shift 2 ;;
    -h|--help) sed -n '2,32p' "$0" | sed 's/^# \?//'; exit 0 ;;
    *)         ONLY="$1"; shift ;;
  esac
done

RED=$'\033[0;31m'; GREEN=$'\033[0;32m'; YELLOW=$'\033[1;33m'; CYAN=$'\033[0;36m'; NC=$'\033[0m'

SYSTEM="$(nix eval --raw --impure --expr 'builtins.currentSystem')"
ARCH="${SYSTEM%%-*}"
echo "${CYAN}Probing unpatched builds on ${SYSTEM}${NC}"
echo

# Read the probe list with `nix eval` and nothing else. The github-runner
# service PATH is built from its extraPackages (nix, git, openssh) and does NOT
# include /run/current-system/sw/bin, so python3 and jq are absent there even
# though they are installed on the host. An earlier version parsed this JSON
# with python3, got "command not found", and printed a clean all-empty summary
# having probed nothing — the exact failure this whole module exists to stop.
names="$(nix eval --raw .#overlayWorkarounds \
  --apply 'ws: builtins.concatStringsSep " " (builtins.attrNames ws)' 2>/dev/null)" \
  || { echo "${RED}could not read .#overlayWorkarounds from the flake${NC}" >&2; exit 1; }

DROPPABLE=()
NEEDED=()
SKIPPED=()
INCONCLUSIVE=()
PROBED=0

# An empty list is never a valid answer: flake.nix has overlays, so it has
# entries. Reaching the summary with nothing probed means the reader broke, and
# that must be loud rather than a tidy "nothing to report".
if [[ -z "${names// /}" ]]; then
  echo "${RED}✗ .#overlayWorkarounds resolved to nothing.${NC}" >&2
  echo "  Refusing to report an all-clear for zero probes." >&2
  exit 1
fi

for name in $names; do
  [[ -n "$ONLY" && "$ONLY" != "$name" ]] && continue

  want="$(nix eval --raw ".#overlayWorkarounds.${name}.arch" 2>/dev/null)"
  note="$(nix eval --raw ".#overlayWorkarounds.${name}.note" 2>/dev/null)"
  if [[ -z "$want" ]]; then
    echo "  ${RED}✗${NC} ${name} — could not read its arch; treating as unprobed"
    INCONCLUSIVE+=("$name (unreadable)")
    continue
  fi
  PROBED=$((PROBED + 1))

  # A probe on the wrong arch answers a different question than the one the
  # overlay exists for — three of these four reproduce only on aarch64, so a
  # clean x86_64 build would say nothing at all about whether the patch is
  # still load-bearing. Skipping loudly beats a false all-clear.
  if [[ "$want" != "any" && "$want" != "$ARCH" ]]; then
    echo "  ${YELLOW}−${NC} ${name} — skipped, reproduces on ${want} only"
    SKIPPED+=("$name (needs $want)")
    continue
  fi

  printf '  … %s (unpatched, up to %ss)\n' "$name" "$TIMEOUT"
  if timeout "$TIMEOUT" nix build --no-link --impure --expr "
        let f = builtins.getFlake \"path:$REPO\";
        in f.inputs.nixpkgs.legacyPackages.\${builtins.currentSystem}.${name}
      " >/dev/null 2>&1; then
    echo "  ${GREEN}✓ ${name} BUILDS CLEAN — the overlay can be dropped${NC}"
    DROPPABLE+=("$name")
  else
    rc=$?
    if [[ $rc -eq 124 ]]; then
      echo "  ${YELLOW}⚠${NC} ${name} — timed out, inconclusive"
      INCONCLUSIVE+=("$name")
    else
      echo "  ${CYAN}·${NC} ${name} — still fails, overlay still needed"
      echo "      ($note)"
      NEEDED+=("$name")
    fi
  fi
done

if [[ $PROBED -eq 0 && -z "$ONLY" ]]; then
  echo
  echo "${RED}✗ probed 0 of the declared overlays — the probe itself is broken.${NC}" >&2
  echo "  A summary of four empty lists is not an all-clear." >&2
  exit 1
fi

echo
echo "${CYAN}── summary ──${NC}"
printf '  still needed : %s\n' "${NEEDED[*]:-none}"
printf '  droppable    : %s\n' "${DROPPABLE[*]:-none}"
printf '  skipped      : %s\n' "${SKIPPED[*]:-none}"
printf '  inconclusive : %s\n' "${INCONCLUSIVE[*]:-none}"
printf '  probed       : %s of %s declared\n' "$PROBED" "$(echo $names | wc -w)"

if [[ -n "${GITHUB_STEP_SUMMARY:-}" ]]; then
  {
    echo "### Overlay expiry probe (${SYSTEM})"
    echo
    echo "| outcome | packages |"
    echo "|---|---|"
    echo "| **droppable** | ${DROPPABLE[*]:-—} |"
    echo "| still needed | ${NEEDED[*]:-—} |"
    echo "| skipped (wrong arch) | ${SKIPPED[*]:-—} |"
    echo "| inconclusive (timeout) | ${INCONCLUSIVE[*]:-—} |"
  } >> "$GITHUB_STEP_SUMMARY"
fi

# Only notify when there is something to DO. A weekly "nothing changed" push is
# how people learn to swipe the topic away, and this shares the homelab topic
# with backup and upgrade failures.
if [[ -n "$NTFY" && ${#DROPPABLE[@]} -gt 0 ]]; then
  curl -s --connect-timeout 5 --max-time 30 --retry 3 --retry-delay 10 --retry-all-errors \
    -H "Title: nixpkgs fixed $( [[ ${#DROPPABLE[@]} -eq 1 ]] && echo "an overlay" || echo "${#DROPPABLE[@]} overlays" )" \
    -H "Priority: 2" -H "Tags: broom" \
    -d "These now build unpatched on ${SYSTEM} and their overlays can be deleted from flake.nix: ${DROPPABLE[*]}" \
    "$NTFY" >/dev/null || true
  echo "  (ntfy digest sent)"
fi

exit 0
